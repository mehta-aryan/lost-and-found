# Copy this file to ".env" and fill it in. ".env" is git-ignored.

# --- Django ---
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-site.example.com
# DJANGO_HTTPS=1

# --- Who may sign in ---
# "gmail.com" lets ANY Gmail user in. Use your college domain, e.g. mycollege.edu
DJANGO_ALLOWED_EMAIL_DOMAIN=gmail.com

# --- Google OAuth (or add a "Social application" in /admin/ instead) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email for message notifications (prints to the console if left alone) ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=Campus Lost & Found <you@gmail.com>
